    local factory = profile.mono and mono or noto
    FONT_BODY = factory(Enum.FontWeight.Regular)
    FONT_LABEL = factory(Enum.FontWeight.Medium)
    FONT_TITLE = factory(Enum.FontWeight.SemiBold)
end
