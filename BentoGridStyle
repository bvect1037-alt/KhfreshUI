-- Bento recipe applicator
function KhfreshUI.ApplyRecipe(frame, recipeName)
    local r = KhfreshUI.BentoRecipes[recipeName]
    if not frame or not r then return end
    pcall(function()
        frame.Size = UDim2.new(r.w or 1, -8, 0, r.h or 100)
        local c = frame:FindFirstChildOfClass("UICorner")
        if c then c.CornerRadius = UDim.new(0, r.radius or 16) end
    end)
end

