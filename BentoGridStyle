local LucidePack = nil
task.spawn(function()
    pcall(function()
        if type(loadstring) ~= "function" then return end
        local body = nil
        if game.HttpGet then
            body = game:HttpGet("https://raw.githubusercontent.com/Footagesus/Icons/main/Main.lua")
        end
        if type(body) == "string" and #body > 200 then
            local fn = loadstring(body)
            if fn then
                local ok, pack = pcall(fn)
                if ok and type(pack) == "table" then LucidePack = pack end
            end
        end
    end)
end)

local ICON_ALIAS = {
    dashboard = "layout-dashboard", tune = "sliders-horizontal", shopping_bag = "shopping-bag",
    assignment_turned_in = "clipboard-check", settings = "settings", expand_more = "chevron-down",
    chevron_right = "chevron-right", close = "x", remove = "minus", add = "plus",
    search = "search", info = "info", check = "check", home = "house",
}

local function resolveIcon(name)
    if type(name) ~= "string" or name == "" then return "circle" end
    if string.find(name, "rbxasset", 1, true) then return name end
    local key = name:lower():gsub("%s+", "_")
    return ICON_ALIAS[key] or ICON_ALIAS[name] or name:gsub("_", "-")
end

local function applyLucide(imageLabel, name)
    if not imageLabel then return false end
    name = resolveIcon(name)
    if string.find(tostring(name), "rbxasset", 1, true) then
        imageLabel.Image = name
        imageLabel.ImageRectOffset = Vector2.zero
        imageLabel.ImageRectSize = Vector2.zero
        return true
    end
    if not LucidePack then return false end
    local data
    pcall(function()
        if LucidePack.Icon then data = LucidePack.Icon(name) end
    end)
    if type(data) ~= "table" then
        pcall(function()
            if LucidePack.GetAsset then data = LucidePack:GetAsset(name) end
        end)
    end
    if type(data) ~= "table" and LucidePack.Icons then
        data = LucidePack.Icons[name]
    end
    if type(data) == "table" then
        local id = data.Image or data[1] or data.id
        local off = data.ImageRectOffset or data[2]
        local sz = data.ImageRectSize or data[3]
        if id then
            imageLabel.Image = type(id) == "string" and id or ("rbxassetid://" .. tostring(id))
            if typeof(off) == "Vector2" then imageLabel.ImageRectOffset = off end
            if typeof(sz) == "Vector2" then imageLabel.ImageRectSize = sz end
            return true
        end
    end
    return false
end

local function materialSymbol(parent, name, position, size, zIndex, color)
    -- Lucide ImageLabel — no EditableImage / base64 pixel bake (mobile-safe)
    local img = make("ImageLabel", {
        Name = "Lucide_" .. tostring(name or "icon"),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = position or UDim2.fromScale(0, 0),
        Size = size or UDim2.fromScale(1, 1),
        ImageColor3 = color or C.muted,
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = zIndex or 4,
    }, parent)
    if not applyLucide(img, name) then
        -- lightweight text fallback while pack loads / missing glyph
        local t = make("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Text = "•",
            TextColor3 = color or C.muted,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            ZIndex = (zIndex or 4) + 1,
        }, img)
    else
        -- retry once pack arrives
        task.defer(function()
            if LucidePack then applyLucide(img, name) end
        end)
    end
    return img
end

