function Section:CreateSlider(config)
    config = config or {}
    local tab = self._tab
    local min, max = config.Min or 0, config.Max or 100
    local current = math.clamp(config.Default or min, min, max)
    local card = bentoCard(tab._scroll, 56, nextOrder(tab))
    local title = label(card, config.Name or "Slider", 12, C.ivory, true)
    title.Position = UDim2.fromOffset(16, 6); title.Size = UDim2.new(0.55, 0, 0, 20); title.ZIndex = 3
    local valueLbl = label(card, tostring(current), 12, C.accent, true)
    valueLbl.Position = UDim2.new(0.55, 0, 0, 6); valueLbl.Size = UDim2.new(0.45, -16, 0, 20)
    valueLbl.TextXAlignment = Enum.TextXAlignment.Right; valueLbl.ZIndex = 3
    local track = make("Frame", { BackgroundColor3 = C.raised, Position = UDim2.fromOffset(16, 34),
        Size = UDim2.new(1, -32, 0, 6), ZIndex = 3 }, card)
    corner(track, 3)
    local fill = make("Frame", { BackgroundColor3 = C.accent,
        Size = UDim2.new((current - min) / math.max(max - min, 1), 0, 1, 0), ZIndex = 4 }, track)
    corner(fill, 3)
    local hit = make("TextButton", { Text = "", BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 26),
        Size = UDim2.new(1, -32, 0, 24), ZIndex = 20, AutoButtonColor = false }, card)
    local sliding = false
    local function setFromX(x, emit)
        local alpha = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        current = min + (max - min) * alpha
        if config.Step then
            local s = config.Step
            current = min + math.floor((current - min) / s + 0.5) * s
        end
        current = math.clamp(current, min, max)
        valueLbl.Text = tostring(math.floor(current * 100) / 100)
        fill.Size = UDim2.new((current - min) / math.max(max - min, 1), 0, 1, 0)
        if emit and config.Callback then task.spawn(config.Callback, current) end
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = true; setFromX(i.Position.X, true)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setFromX(i.Position.X, true)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then sliding = false end
    end)
    return { Get = function() return current end, _frame = card }
end

