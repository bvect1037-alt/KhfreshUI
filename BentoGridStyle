function KhfreshUI:Notify(config)
    config = config or {}
    local host = self._notificationGui
    if not host or not host.Parent then
        host = make("ScreenGui", {
            Name = "KhfreshNotify", ResetOnSpawn = false, IgnoreGuiInset = true,
            DisplayOrder = 2147483000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        }, guiParent)
        self._notificationGui = host
        local wrap = make("Frame", {
            BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
        }, host)
        listLayout(wrap, 8, Enum.FillDirection.Vertical)
        local lay = wrap:FindFirstChildOfClass("UIListLayout")
        if lay then
            lay.HorizontalAlignment = Enum.HorizontalAlignment.Right
            lay.VerticalAlignment = Enum.VerticalAlignment.Bottom
        end
        pad(wrap, 0, 16, 0, 16)
        host = wrap
        self._notificationHost = wrap
    end
    local parent = self._notificationHost or host
    local card = make("Frame", {
        BackgroundColor3 = C.shell, BorderSizePixel = 0,
        Size = UDim2.fromOffset(300, 68), LayoutOrder = -math.floor(tick()*1000),
    }, parent)
    corner(card, 16)
    stroke(card, C.accent, 0.45, 1)
    lucideIcon(card, config.Icon or "info", UDim2.fromOffset(14, 22), UDim2.fromOffset(24, 24), 3, C.accent)
    local t = label(card, config.Title or "Khfresh", 13, C.ivory, true)
    t.Position = UDim2.fromOffset(48, 12); t.Size = UDim2.new(1, -60, 0, 20)
    local d = label(card, config.Content or config.Message or "", 11, C.secondary, false)
    d.Position = UDim2.fromOffset(48, 34); d.Size = UDim2.new(1, -60, 0, 24); d.TextWrapped = true
    task.delay(tonumber(config.Duration) or 3, function()
        if card.Parent then
            tween(card, Motion.fast, { BackgroundTransparency = 1 })
            task.wait(0.15)
            pcall(function() card:Destroy() end)
        end
    end)
end

