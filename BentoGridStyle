function Section:CreateMultiDropdown(config)
    config = config or {}
    local tab = self._tab
    local options = config.Options or config.Values or {}
    local selected = {}
    for _, v in ipairs(config.Default or {}) do selected[tostring(v)] = true end
    local card = bentoCard(tab._scroll, 48, nextOrder(tab))
    local title = label(card, config.Name or "Multi", 12, C.secondary, true)
    title.Position = UDim2.fromOffset(16, 0); title.Size = UDim2.new(0.4, 0, 1, 0); title.ZIndex = 3
    local valueLbl = label(card, "None", 12, C.ivory, false)
    valueLbl.Position = UDim2.new(0.4, 0, 0, 0); valueLbl.Size = UDim2.new(0.6, -16, 1, 0)
    valueLbl.TextXAlignment = Enum.TextXAlignment.Right; valueLbl.ZIndex = 3
    local function refresh()
        local list = {}
        for _, o in ipairs(options) do if selected[tostring(o)] then list[#list+1] = o end end
        valueLbl.Text = #list == 0 and "None" or table.concat(list, ", ")
        if config.Callback then task.spawn(config.Callback, list) end
    end
    local idx = 0
    local hit = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 20, AutoButtonColor = false }, card)
    bindClick(hit, function()
        if #options == 0 then return end
        idx = idx % #options + 1
        local o = tostring(options[idx])
        selected[o] = not selected[o]
        refresh()
    end)
    refresh()
    return { Get = function()
        local list = {}
        for _, o in ipairs(options) do if selected[tostring(o)] then list[#list+1] = o end end
        return list
    end, _frame = card }
end

