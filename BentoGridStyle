KhfreshUI.Layout = {}
function KhfreshUI.Layout.ComputeGrid(count, cols, gap, width)
    cols = math.max(1, cols or 2)
    gap = gap or 10
    width = width or 500
    local cellW = math.floor((width - gap * (cols - 1)) / cols)
    local rows = math.ceil(count / cols)
    return { cellW = cellW, rows = rows, cols = cols, gap = gap }
end

function KhfreshUI.Layout.FeatureSpan(totalCols)
    return math.max(1, math.floor((totalCols or 2)))
end

