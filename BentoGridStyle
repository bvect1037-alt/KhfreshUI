-- ========== INSTANCE HELPERS ==========
local function make(className, props, parent)
    local o = Instance.new(className)
    if props then for k, v in pairs(props) do o[k] = v end end
    if parent then o.Parent = parent end
    return o
end

local function corner(parent, r)
    return make("UICorner", { CornerRadius = UDim.new(0, r or 16) }, parent)
end

local function stroke(parent, color, tr, th)
    return make("UIStroke", {
        Color = color or C.line,
        Transparency = tr or 0.5,
        Thickness = th or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function pad(parent, l, r, t, b)
    return make("UIPadding", {
        PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or 0),
        PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or 0),
    }, parent)
end

local function listLayout(parent, padY, dir)
    return make("UIListLayout", {
        Padding = UDim.new(0, padY or 8),
        FillDirection = dir or Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, parent)
end

local function gridLayout(parent, cellX, cellY, padX, padY)
    return make("UIGridLayout", {
        CellSize = UDim2.fromOffset(cellX or 160, cellY or 120),
        CellPadding = UDim2.fromOffset(padX or 10, padY or 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirectionMaxCells = 2,
    }, parent)
end

local function tween(obj, info, props)
    if not obj then return end
    local a = TweenService:Create(obj, info or Motion.base, props)
    a:Play()
    return a
end

local function label(parent, text, size, color, bold)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = text or "",
        TextColor3 = color or C.ivory,
        TextSize = size or 13,
        Font = bold and Enum.Font.GothamMedium or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextWrapped = false,
    }, parent)
end

local function bindClick(gui, fn)
    if not gui or not fn then return end
    if gui:IsA("GuiButton") then
        gui.MouseButton1Click:Connect(function() task.spawn(fn) end)
    else
        local b = make("TextButton", {
            Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
            ZIndex = 50, AutoButtonColor = false,
        }, gui)
        b.MouseButton1Click:Connect(function() task.spawn(fn) end)
    end
end

local function hoverLift(frame, amount)
    amount = amount or 0.04
    local base = frame.BackgroundColor3
    frame.MouseEnter:Connect(function()
        tween(frame, Motion.hover, { BackgroundColor3 = C.hover })
    end)
    frame.MouseLeave:Connect(function()
        tween(frame, Motion.hover, { BackgroundColor3 = base })
    end)
end

-- ========== BENTO GRID PATTERN (visual) ==========
local function addGridPattern(parent, z)
    -- subtle grid lines like reference bento cards
    local holder = make("Frame", {
        Name = "GridPattern",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = z or 1,
        ClipsDescendants = true,
    }, parent)
    for i = 1, 8 do
        make("Frame", {
            BackgroundColor3 = C.grid,
            BackgroundTransparency = 0.82,
            BorderSizePixel = 0,
            Position = UDim2.new(i / 9, 0, 0, 0),
            Size = UDim2.new(0, 1, 1, 0),
            ZIndex = z or 1,
        }, holder)
        make("Frame", {
            BackgroundColor3 = C.grid,
            BackgroundTransparency = 0.82,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, i / 9, 0),
            Size = UDim2.new(1, 0, 0, 1),
            ZIndex = z or 1,
        }, holder)
    end
    return holder
end

